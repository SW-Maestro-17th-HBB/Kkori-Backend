# 로컬 개발용 시크릿 템플릿. 이 파일을 .env로 복사한 뒤 실제 값을 채운다.
# .env는 Git 비추적(.gitignore) — 실제 자격증명을 커밋하지 말 것.
# springboot3-dotenv가 부팅 시 .env를 읽어 아래 키를 환경변수로 노출한다.

# LiveKit Cloud 프로젝트 자격증명 (https://cloud.livekit.io 프로젝트 설정에서 발급)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 토큰 만료(선택, 미설정 시 1h). 만료 테스트 시 예: 3s
# LIVEKIT_TOKEN_TTL=1h
